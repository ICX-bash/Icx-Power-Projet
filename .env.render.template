# ICX Power Solutions SRL — variables Render
# Copiez ce fichier dans Render > Environment > Environment Variables.
# Ne committez jamais ce fichier avec de vraies clés.

# -----------------------------------------------------------------------------
# RUNTIME RENDER
# -----------------------------------------------------------------------------
NODE_ENV=production
# Render injecte généralement PORT automatiquement. 10000 est la valeur courante.
PORT=10000

# -----------------------------------------------------------------------------
# BASE DE DONNÉES
# -----------------------------------------------------------------------------
# Obligatoire. Le projet utilise MySQL/TiDB via mysql2.
# Utilisez une base MySQL/TiDB compatible et copiez son URL complète.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# -----------------------------------------------------------------------------
# SESSION ET AUTHENTIFICATION MANUS
# -----------------------------------------------------------------------------
# Générez une valeur unique avec : openssl rand -base64 32
JWT_SECRET=REMPLACEZ_PAR_UN_SECRET_ALEATOIRE_LONG

# Valeurs fournies par votre configuration Manus OAuth
VITE_APP_ID=REMPLACEZ_PAR_VOTRE_MANUS_APP_ID
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=REMPLACEZ_PAR_VOTRE_PORTAIL_OAUTH_MANUS
OWNER_OPEN_ID=REMPLACEZ_PAR_VOTRE_OWNER_OPEN_ID
OWNER_NAME=ICX Power Solutions SRL

# -----------------------------------------------------------------------------
# MANUS BUILT-IN FORGE — IA, stockage et services internes
# -----------------------------------------------------------------------------
# Nécessaires à l’assistant ICX Intelligence et aux services Manus utilisés
# par l’application. Récupérez ces valeurs dans votre environnement Manus.
BUILT_IN_FORGE_API_URL=REMPLACEZ_PAR_VOTRE_BUILT_IN_FORGE_API_URL
BUILT_IN_FORGE_API_KEY=REMPLACEZ_PAR_VOTRE_BUILT_IN_FORGE_API_KEY

# Utilisées côté navigateur uniquement si le composant Map est activé.
VITE_FRONTEND_FORGE_API_URL=REMPLACEZ_PAR_VOTRE_VITE_FRONTEND_FORGE_API_URL
VITE_FRONTEND_FORGE_API_KEY=REMPLACEZ_PAR_VOTRE_VITE_FRONTEND_FORGE_API_KEY

# -----------------------------------------------------------------------------
# RESEND — EMAILS TRANSACTIONNELS
# -----------------------------------------------------------------------------
# Créez une clé dans Resend. Ne la partagez jamais.
RESEND_API_KEY=re_REMPLACEZ_PAR_VOTRE_CLE_RESEND
RESEND_FROM_NAME=ICX Power Solutions SRL
RESEND_FROM_EMAIL=contact@VOTRE_DOMAINE_VERIFIE.com
RESEND_REPLY_TO=icxps.sale@outlook.com

# Optionnel : uniquement pour newsletters/contacts Resend.
# RESEND_AUDIENCE_ID=REMPLACEZ_SI_UTILISE

# -----------------------------------------------------------------------------
# ADMINISTRATION ET URL PUBLIQUE
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=icxps.sale@outlook.com
NEXT_PUBLIC_SITE_URL=https://VOTRE-SERVICE.onrender.com

# -----------------------------------------------------------------------------
# STOCKAGE EXTERNE — OPTIONNEL
# -----------------------------------------------------------------------------
# À utiliser seulement si vous branchez un bucket S3 compatible séparé.
# STORAGE_BUCKET=VOTRE_BUCKET

# -----------------------------------------------------------------------------
# SMTP — INUTILE SI VOUS UTILISEZ RESEND
# -----------------------------------------------------------------------------
# Ne renseignez pas ces variables avec Resend API.
# SMTP_HOST=smtp.votre-fournisseur.com
# SMTP_PORT=587
# SMTP_USER=votre-utilisateur-smtp
# SMTP_PASSWORD=votre-mot-de-passe-smtp
