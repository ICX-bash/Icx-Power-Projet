# ICX Power Solutions SRL — variables pour Render
# Modèle uniquement : saisissez les vraies valeurs dans Render > service > Environment.
# Ne committez jamais une vraie clé, un mot de passe ou un jeton.

NODE_ENV=production
PORT=10000

# Base externe TiDB/MySQL (schéma dédié au projet; ne pas utiliser le schéma système `sys`).
# Copiez l’URL fournie par TiDB Cloud, avec TLS selon les consignes TiDB.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:4000/ICX_DATABASE
DATABASE_SSL=true

# Session du portail client Manus (reste inchangée).
JWT_SECRET=REMPLACEZ_PAR_UN_SECRET_ALEATOIRE_LONG
VITE_APP_ID=REMPLACEZ_PAR_VOTRE_MANUS_APP_ID
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=REMPLACEZ_PAR_VOTRE_PORTAIL_OAUTH_MANUS
OWNER_OPEN_ID=REMPLACEZ_PAR_VOTRE_OWNER_OPEN_ID
OWNER_NAME=ICX Power Solutions SRL
SUPER_ADMIN_EMAIL=icxps.sale@outlook.com
NEXT_PUBLIC_SITE_URL=https://VOTRE-SERVICE.onrender.com

# Microsoft Entra — connexion admin /admin uniquement et accès Outlook délégué.
# L’application doit autoriser les comptes personnels Microsoft et le callback doit
# correspondre exactement à MICROSOFT_REDIRECT_URI dans Entra ID.
MICROSOFT_TENANT_ID=consumers
MICROSOFT_CLIENT_ID=REMPLACEZ_PAR_APPLICATION_CLIENT_ID
MICROSOFT_CLIENT_SECRET=REMPLACEZ_DANS_RENDER_SANS_LE_COMMITTER
MICROSOFT_REDIRECT_URI=https://VOTRE-SERVICE.onrender.com/api/admin/auth/callback
# Générer avec: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=REMPLACEZ_PAR_32_OCTETS_EN_BASE64

# Microsoft Graph — permissions déléguées à activer dans l’app: User.Read,
# Mail.ReadWrite et Mail.Send; scopes demandés au premier login admin.

# Resend — courriels sortants du formulaire et de la console admin.
# RESEND_FROM_EMAIL doit appartenir à un domaine vérifié dans Resend.
RESEND_API_KEY=re_REMPLACEZ_DANS_RENDER_SANS_LE_COMMITTER
RESEND_FROM_NAME=ICX Power Solutions SRL
RESEND_FROM_EMAIL=contact@VOTRE-DOMAINE-VERIFIE.com
RESEND_REPLY_TO=icxps.sale@outlook.com

# Manus Forge — stockage actuel des pièces jointes du portail client.
# Gardez ces deux valeurs jusqu’à migration vers un stockage objet indépendant.
BUILT_IN_FORGE_API_URL=REMPLACEZ_PAR_VOTRE_BUILT_IN_FORGE_API_URL
BUILT_IN_FORGE_API_KEY=REMPLACEZ_PAR_VOTRE_BUILT_IN_FORGE_API_KEY

# SMTP non utilisé par l’application lorsque Resend est activé.
